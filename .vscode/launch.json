{
  // F5 starts the API under the debugger (breakpoints work in api/, engine/, llm/…).
  // The web app is not a debug target — run it with the "AIRA: Web (Vite)" task.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AIRA: API (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["api.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "jinja": false,
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
