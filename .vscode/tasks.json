{
  // Run these from  Terminal ▸ Run Task…  (or Ctrl+Shift+P ▸ "Tasks: Run Task").
  // "AIRA: start everything" runs the API and the web app together.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AIRA: API (FastAPI)",
      "type": "shell",
      "command": "py -3.11 -m uvicorn api.main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "aira", "panel": "dedicated", "clear": true }
    },
    {
      "label": "AIRA: Web (Vite)",
      "type": "shell",
      "command": "npm run dev -- --host 0.0.0.0",
      "options": { "cwd": "${workspaceFolder}/web" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "aira", "panel": "dedicated" }
    },
    {
      "label": "AIRA: start everything",
      "dependsOn": ["AIRA: API (FastAPI)", "AIRA: Web (Vite)"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "AIRA: seed demo data",
      "type": "shell",
      "command": "py -3.11 demo/seed.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "AIRA: run tests",
      "type": "shell",
      "command": "py -3.11 -m pytest tests/ -q",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
